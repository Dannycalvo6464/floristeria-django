# Copia este archivo a .env solo para uso local. No guardes secretos en Git.
# Si DATABASE_URL se deja vacía, Django usa db.sqlite3 local.
DATABASE_URL=
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# SMTP opcional para recuperación de contraseña (no usar consola para exponer códigos).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
